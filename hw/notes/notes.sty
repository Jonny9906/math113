\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notes}[2026/10/28 Jonathan Nguyen's math notes]

\RequirePackage[margin=1in]{geometry}
\RequirePackage{amsmath, amssymb, amsthm}
\RequirePackage[most]{tcolorbox}

\definecolor{definitionbody}{HTML}{E5FFE5}
\definecolor{definitiontitle}{HTML}{C5FFC5}
\definecolor{theorembody}{HTML}{E3F4FA}
\definecolor{theoremtitle}{HTML}{C5E7F2}
\definecolor{corollarybody}{HTML}{EFEAFA}
\definecolor{corollarytitle}{HTML}{DCD2F2}

\tcbset{
    notesbox/.style={
        enhanced,
        breakable,
        frame hidden,
        boxrule=0pt,
        arc=2pt,
        coltitle=black,
        fonttitle=\bfseries,
        left=10pt,
        right=10pt,
        top=7pt,
        bottom=7pt,
        toptitle=5pt,
        bottomtitle=5pt,
        before skip=12pt,
        after skip=12pt
    }
}

\newtcolorbox{definition}[1][Definition]{
    notesbox,
    title={#1},
    colback=definitionbody,
    colbacktitle=definitiontitle
}

\newtcolorbox{theorem}{
    notesbox,
    title=Theorem,
    colback=theorembody,
    colbacktitle=theoremtitle
}

\newtcolorbox{corollary}{
    notesbox,
    title=Corollary,
    colback=corollarybody,
    colbacktitle=corollarytitle
}

\endinput
